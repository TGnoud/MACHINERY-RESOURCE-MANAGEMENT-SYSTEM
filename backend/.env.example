NODE_ENV=development
PORT=3000

# Set this in Render Environment Variables. Do not commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/GnoudCRM?retryWrites=true&w=majority

# Comma-separated allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000,https://machinery-resource-management-syste.vercel.app

# Use long random values in production.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PASSWORD_RESET_SECRET=change-me-reset-secret
