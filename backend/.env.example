NODE_ENV=development
PORT=3000

# Set this in Render Environment Variables. Do not commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Comma-separated allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000,https://machinery-resource-management-syste.vercel.app
